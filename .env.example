# ---------------------------------------------------------------------------
# prodrome configuration. Copy to .env; every value here is optional.
# The pipeline runs end to end with this file absent.
# ---------------------------------------------------------------------------

# openFDA API key. Optional but strongly recommended: it lifts the quota from
# 1,000 requests/day/IP to 120,000 requests/day/key. Free, no card, instant.
#   https://open.fda.gov/apis/authentication/  -> "Get an API key"
PRODROME_OPENFDA_API_KEY=

# Optional weekly narrative brief. Leave blank to emit the deterministic
# template instead -- no model call, byte-identical across runs.
#   Google AI Studio -> "Get API key": https://aistudio.google.com/apikey
PRODROME_LLM_PROVIDER=none       # none | gemini | groq
PRODROME_LLM_API_KEY=
PRODROME_LLM_MODEL=

# Embedding backend for label-mention detection.
#   hashed  - dependency-free, deterministic, used in CI
#   onnx    - local MiniLM via fastembed; needs the `embed` extra
PRODROME_EMBED_BACKEND=hashed
